# ──────────────────────────────────────────────────────────────────────────────
# Mateo Ríos Landing — Variables de entorno
# Copia este archivo como .env.local y completa los valores antes de desplegar
# ──────────────────────────────────────────────────────────────────────────────

# Webhook que recibe el formulario de demo (POST con JSON)
# Puede ser un endpoint propio, Make, Zapier, n8n, etc.
NEXT_PUBLIC_FORM_WEBHOOK_URL=

# URL de Calendly para el botón "Agendar reunión"
# Ejemplo: https://calendly.com/tu-usuario/demo-mateo-rios
NEXT_PUBLIC_CALENDLY_URL=

# URL embebida del video demo (YouTube embed, Loom, Vimeo, etc.)
# Ejemplo (YouTube): https://www.youtube.com/embed/VIDEO_ID?autoplay=1
NEXT_PUBLIC_VIDEO_URL=

# ID de Google Tag Manager para analítica
# Ejemplo: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Variante A/B activa: A (dolor), B (control), C (velocidad)
# Valor por defecto: A
NEXT_PUBLIC_AB_VARIANT=A
